# Servicio de la tienda para systemd (Ubuntu).
# Mantiene la tienda funcionando: la inicia al prender el servidor y la reinicia si se cae.
#
# Instalar:  sudo cp /opt/tienda-online/deploy/tienda.service /etc/systemd/system/tienda.service
#            sudo systemctl daemon-reload && sudo systemctl enable --now tienda
# Ver estado: sudo systemctl status tienda
# Ver registros: sudo journalctl -u tienda -n 100 --no-pager

[Unit]
Description=Tienda online Todo Herramientas
After=network.target

[Service]
Type=simple
User=tienda
Group=tienda
WorkingDirectory=/opt/tienda-online
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Environment=NODE_ENV=production
Environment=PORT=3000
# Sólo escucha dentro del servidor: al público se llega a través de Nginx (HTTPS)
Environment=HOST=127.0.0.1
Restart=always
RestartSec=3

# Protecciones: la tienda sólo puede escribir en sus carpetas de datos
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tienda-online/data /opt/tienda-online/uploads

[Install]
WantedBy=multi-user.target
